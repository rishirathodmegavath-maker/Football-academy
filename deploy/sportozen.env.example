# Production environment for Sportozen Academy.
#
# Install as /etc/sportozen/sportozen.env, owner root, mode 0600:
#   sudo install -m 0600 -o root -g root deploy/sportozen.env.example /etc/sportozen/sportozen.env
# systemd reads it (EnvironmentFile) and release.sh passes it to node --env-file.
# Format: NAME=value, one per line, no `export`, no inline comments. Quote a value
# ONLY where its comment says so (SPORTOZEN_ALERT_COMMAND, single quotes).
# Never commit the filled-in file. Never paste its values into tickets or chat.
#
# `node scripts/preflight.mjs` checks this file before every start. Lines marked
# OWNER DECISION must stay empty until the owner approves them.

# --- Application identity -------------------------------------------------
# Public origin, HTTPS, no path. Needed at BUILD time too (HSTS is baked in).
# OWNER DECISION: domain name.
BETTER_AUTH_URL=

# Generate once, keep in the owner's secret store, 32+ characters:
#   openssl rand -base64 48
# Changing it signs every user out. Back it up: it is needed after a restore.
BETTER_AUTH_SECRET=

# Which kind of environment this is: production | pilot | staging | development | local.
# Only the exact value "production" hides the "Pilot environment. Please do not enter real
# customer information yet." notice on the sign-in screen. Any other value, an empty value, a
# missing line or a misspelling ("prod") SHOWS the notice, deliberately. The address above is
# NOT used to guess. Set it to production only on the live deployment.
SPORTOZEN_ENVIRONMENT=production

# --- Persistent storage ---------------------------------------------------
# Absolute path on a persistent disk, outside the release directory.
SPORTOZEN_DATABASE_PATH=/var/lib/sportozen/workspaces.sqlite

# --- Reverse proxy trust --------------------------------------------------
# Leave empty when the proxy OVERWRITES X-Forwarded-For with the client address
# (the supplied nginx and Caddy configurations do). Set only when another proxy
# or CDN sits in front and APPENDS to the header: list its address ranges,
# comma separated, e.g. 10.0.0.0/8,192.0.2.0/24.
SPORTOZEN_TRUSTED_PROXIES=
# Optional: a header the proxy sets itself (e.g. cf-connecting-ip). Default x-forwarded-for.
SPORTOZEN_CLIENT_IP_HEADER=

# --- Limits ---------------------------------------------------------------
# State-changing requests per signed-in user per minute (default 240).
# SPORTOZEN_WRITE_LIMIT_PER_MINUTE=240

# --- Email -------------------------------------------------------------------
# One transport for every message, worldwide: disabled (default) or postmark.
# ("capture" and "file" are for tests and local development and are refused for
# a deployment.) OWNER DECISION: provider account, sending domain, sender address.
# Until they are made keep "disabled": verification, recovery and invitation
# e-mail then stay off. See docs/EMAIL.md for the exact external requirements.
SPORTOZEN_EMAIL_TRANSPORT=disabled
# A sender address on a domain verified with the provider (SPF, DKIM, DMARC set up),
# for example: Sportozen Academy <notifications@mail.example-domain>
SPORTOZEN_EMAIL_FROM=
SPORTOZEN_EMAIL_VERIFICATION=off
SPORTOZEN_PASSWORD_RECOVERY=off
# Postmark only. The Server API token of the message stream used for these mails.
SPORTOZEN_POSTMARK_TOKEN=
# Message stream id (default "outbound", Postmark's transactional stream).
SPORTOZEN_POSTMARK_STREAM=outbound
# Bounce and complaint reports: set these here AND as the Basic-auth user and
# password of Postmark's webhook URL https://<your host>/api/email/webhooks/postmark
# (password 16+ characters). Leave empty to switch the endpoint off.
SPORTOZEN_POSTMARK_WEBHOOK_USER=
SPORTOZEN_POSTMARK_WEBHOOK_PASSWORD=
# Optional: extra browser origins allowed to sign in (exact origins, comma
# separated, https only). Never a wildcard. Normally empty.
BETTER_AUTH_TRUSTED_ORIGINS=

# --- Accounts (WP6) --------------------------------------------------------
# Who MUST use two-step verification (authenticator app): off | staff | all.
# OWNER DECISION (docs/AUTHENTICATION.md). Anyone may enrol whatever this says.
SPORTOZEN_MFA=off
# Absolute session length in hours (default 8). Optional idle timeout in minutes
# (unset = no idle timeout, as before). Both are owner decisions.
SPORTOZEN_SESSION_MAX_HOURS=8
SPORTOZEN_SESSION_IDLE_MINUTES=
# Failed sign-ins per account per 15 minutes before it is paused (default 10).
SPORTOZEN_SIGNIN_FAILURE_LIMIT=10

# --- Monitoring and alerts (WP8) -------------------------------------------
# Nothing is sent anywhere unless you set a destination (OWNER DECISION: who is
# alerted and how; docs/OPERATIONS.md). Either or both:
#   a command run WITHOUT a shell; {subject}, {body}, {severity} are replaced.
#   The JSON MUST be inside single quotes: systemd's EnvironmentFile would
#   otherwise strip the double quotes and the alert path would be dead.
#   SPORTOZEN_ALERT_COMMAND='["/usr/local/bin/notify","{severity}","{subject}"]'
#   After setting it, prove it works:  node scripts/ops-check.mjs --test-alert
SPORTOZEN_ALERT_COMMAND=
#   Hard limit for the command in seconds, 1-20 (default 20). At the limit the command and
#   everything it started is killed and the alert is retried on the next pass.
# SPORTOZEN_ALERT_COMMAND_TIMEOUT_SECONDS=20
#   an https:// address that accepts a JSON POST (chat tool, paging service):
SPORTOZEN_ALERT_WEBHOOK_URL=
# Label used in alert messages (default: the host name).
SPORTOZEN_SERVER_NAME=
# Log lines below this level are dropped: info (default), warn or error.
SPORTOZEN_LOG_LEVEL=info
# The public name whose TLS certificate expiry is watched (optional).
SPORTOZEN_OPS_CERT_HOST=
# Worker heartbeat: auto (default) checks it once the worker has run; true makes a
# missing heartbeat critical; false never checks.
SPORTOZEN_OPS_EXPECT_WORKER=auto

# --- Browser security policy (WP7) -----------------------------------------
# enforce (default) | report-only (log violations, block nothing, for a staged
# roll-out) | off. Violations are logged as "csp.violation" security events.
SPORTOZEN_CSP=enforce

# --- Backups (WP4) ---------------------------------------------------------
# Staging directory on this server, OUTSIDE the release and database directories.
SPORTOZEN_BACKUP_DIR=/var/backups/sportozen
# Where the encrypted copies go OFF this server. Exactly one of:
#   SPORTOZEN_BACKUP_TARGET_DIR      a directory that is a mounted remote store
#   SPORTOZEN_BACKUP_TARGET_COMMAND  a command run without a shell; {file} and {name} are replaced
# OWNER DECISION: storage provider and account.
SPORTOZEN_BACKUP_TARGET_DIR=
SPORTOZEN_BACKUP_TARGET_COMMAND=
# 32 random bytes, base64: openssl rand -base64 32
# Store a copy OUTSIDE this server. Without it the backups cannot be read.
SPORTOZEN_BACKUP_ENCRYPTION_KEY=
# Retention: how many to keep. OWNER DECISION on the numbers (defaults shown).
SPORTOZEN_BACKUP_KEEP_HOURLY=24
SPORTOZEN_BACKUP_KEEP_DAILY=30
SPORTOZEN_BACKUP_KEEP_MONTHLY=12
# Recovery objectives in minutes. OWNER DECISION: leave empty until approved.
SPORTOZEN_BACKUP_RPO_MINUTES=
SPORTOZEN_BACKUP_RTO_MINUTES=

# --- Optional integrations (disabled until configured) -----------------------
# SPORTOZEN_GOOGLE_PLACES_ENABLED=
# SPORTOZEN_WHATSAPP_SEND_ENABLED=

# /etc/systemd/system/sportozen-backup.service
# One verified, encrypted backup of the live database, copied off this server.
# Run by sportozen-backup.timer; run it by hand with:
#   sudo systemctl start sportozen-backup.service
# Exit status 2 means "stored here but NOT copied off the server": treat as an alert.
[Unit]
Description=Sportozen Academy database backup
# Not Requires=: a backup must still run if the web service is down.
After=network-online.target
Wants=network-online.target

# WP8: tell the operator when this unit fails (crash loop, failed backup).
OnFailure=sportozen-alert@%n.service

[Service]
Type=oneshot
User=sportozen
Group=sportozen
WorkingDirectory=/srv/sportozen/current
EnvironmentFile=/etc/sportozen/sportozen.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node scripts/backup-database.mjs
# Only the data and staging directories are writable; reads everything else.
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
LockPersonality=true
# Added by the WP7 hardening pass (not yet run under systemd: check with
# `systemd-analyze security <unit>` on the first deployment).
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=true
RestrictRealtime=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
SystemCallArchitectures=native
# If the off-server copy uses a mounted directory, add it here; if it uses
# rclone or ssh, keep their configuration under /etc/sportozen (not a home
# directory, which ProtectHome hides) and name it in the upload command,
# e.g. rclone --config /etc/sportozen/rclone.conf. Run the unit once by hand
# after any change: a blocked upload exits 2 ("not copied off the server").
ReadWritePaths=/var/lib/sportozen /var/backups/sportozen
# A stuck upload must not run forever.
TimeoutStartSec=1h
Nice=10
IOSchedulingClass=idle
